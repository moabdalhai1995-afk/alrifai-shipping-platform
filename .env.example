# Core application
NODE_ENV=production
PORT=3000
BASE_URL=https://alrifai-shipping-platform.onrender.com
SESSION_SECRET=replace-with-a-long-random-secret
SETUP_KEY=replace-with-a-long-random-setup-key
DB_FILE=./alrifai.db
DATABASE_URL=

# Email / account verification
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google sign-in
GOOGLE_CLIENT_ID=

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_API_VERSION=v23.0

# Optional AI provider. Leave empty to use the local assistant mode.
OPENAI_API_KEY=
OPENAI_MODEL=
